# Copy thành .env (KHÔNG commit .env). Dùng chung cho docker compose và backend.

# --- Tên miền ---
# HTTPS do Nginx trên VPS lo (deploy/nginx.conf + certbot). SITE_URL dùng cho link tuyệt đối của web.
SITE_URL=https://leadscan.net
# Cổng api/web mở trên 127.0.0.1 để Nginx gọi vào. Đổi nếu VPS đã có ứng dụng khác dùng 8012/3012
# (nhớ sửa 2 upstream trong deploy/nginx.conf cho khớp).
API_PORT=8012
WEB_PORT=3012

# --- Cơ sở dữ liệu (đặt mật khẩu dài, ngẫu nhiên) ---
POSTGRES_PASSWORD=

# Tên miền được phép gửi form & thao tác admin (JSON)
LEADSCAN_ALLOWED_HOSTS=["leadscan.net"]

# Cookie đăng nhập admin chỉ gửi qua HTTPS. Chỉ đặt false khi chạy thử http://localhost
LEADSCAN_COOKIE_SECURE=true
LEADSCAN_SESSION_DAYS=7

# --- Gửi email: Resend (khuyên dùng) hoặc SMTP ---
# auto = dùng Resend nếu có API key, ngược lại SMTP · resend · smtp
LEADSCAN_MAIL_MAILER=resend
LEADSCAN_RESEND_API_KEY=
# Địa chỉ gửi đi — tên miền phải được xác minh trong Resend (Domains)
LEADSCAN_NOTIFY_FROM=no-reply@mcv.network
LEADSCAN_MAIL_FROM_NAME=MCV Network
# Email báo quản trị khi có đăng ký mới (để trống = không gửi)
LEADSCAN_NOTIFY_EMAIL=
LEADSCAN_ADMIN_URL=https://leadscan.net/admin
# SMTP (chỉ dùng khi không có Resend)
LEADSCAN_SMTP_HOST=
LEADSCAN_SMTP_PORT=587
LEADSCAN_SMTP_USER=
LEADSCAN_SMTP_PASSWORD=
LEADSCAN_SMTP_SSL=false

# --- Cổng thành viên ---
LEADSCAN_MEMBER_URL=https://leadscan.net/thanh-vien

# --- Thanh toán (InfoCMS Smart Collect — VietQR) ---
# infocms = thật · mock = giả lập để chạy thử (có nút "Giả lập đã thanh toán"; KHÔNG dùng trên production)
LEADSCAN_PAYMENT_PROVIDER=infocms
# Tài khoản thu do InfoCMS cấp (để sinh mã VietQR). BIN theo NAPAS, vd 970436 = Vietcombank, 970418 = BIDV
LEADSCAN_PAYMENT_BANK_BIN=
LEADSCAN_PAYMENT_BANK_NAME=
LEADSCAN_PAYMENT_ACCOUNT_NO=
LEADSCAN_PAYMENT_ACCOUNT_NAME=
# Webhook InfoCMS gọi về: https://<tên miền>/api/payments/infocms/webhook (ký HMAC-SHA256 trên body)
LEADSCAN_INFOCMS_WEBHOOK_SECRET=
LEADSCAN_INFOCMS_SIGNATURE_HEADER=X-Signature
LEADSCAN_ORDER_EXPIRE_HOURS=24

# Gói thành viên & nạp điểm (1 điểm = 1đ)
LEADSCAN_MEMBERSHIP_FEE=10000000
LEADSCAN_MEMBERSHIP_POINTS=10000000
LEADSCAN_MEMBERSHIP_DAYS=365
LEADSCAN_TOPUP_PACKS=[5000000,10000000,20000000,50000000]
LEADSCAN_TOPUP_MIN=1000000

# --- So khớp cơ hội (embedding Cohere + pgvector, chạy nền bằng Celery worker) ---
# Chỉ cần khoá API Cohere (https://dashboard.cohere.com/api-keys). Model & endpoint đã cài sẵn:
# Embed 5 Pro nhúng phiếu cơ hội, Embed 5 Fast nhúng phiếu tìm của khách, 1024 chiều, https://api.cohere.com/v2/embed.
# Để trống = dùng vector "hash" chạy tại chỗ (chỉ nên dùng khi chạy thử).
# Khoá Trial (miễn phí) dùng được các model trên nhưng: tối đa 1.000 lần gọi/tháng, 2.000 văn bản/phút và
# Cohere KHÔNG cho dùng khoá Trial cho mục đích thương mại/production. Hết lượt → so khớp chỉ dùng tiêu chí + từ khoá.
COHERE_API_KEY=
# Hạn mức lượt gọi Cohere mỗi tháng (khớp khoá Trial). Đổi sang khoá Production thì đặt 0 = không giới hạn.
LEADSCAN_COHERE_MONTHLY_LIMIT=1000

# Yêu cầu xuất hoá đơn gửi tới email kế toán (xuất thủ công). Cần cấu hình Resend/SMTP ở trên để gửi được.
LEADSCAN_INVOICE_EMAIL=vylyy9999@gmail.com

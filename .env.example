# Copy thành .env (KHÔNG commit .env). Dùng chung cho docker compose và backend.

# --- Tên miền ---
# HTTPS do Nginx trên VPS lo (deploy/nginx.conf + certbot). SITE_URL dùng cho link tuyệt đối của web.
SITE_URL=https://leadscan.net
# SEO: mã xác minh Google Search Console / Bing Webmaster (phần content="…" của thẻ meta). Đổi xong phải build lại web.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4: Measurement ID dạng G-XXXXXXXXXX (GA → Quản trị → Luồng dữ liệu → Web). Để trống = không đo. Đổi xong phải build lại web.
# Chỉ đo trang công khai; admin / cổng thành viên / cổng đối tác không gửi dữ liệu.
GA_MEASUREMENT_ID=
# Cổng api/web mở trên 127.0.0.1 để Nginx gọi vào. Đổi nếu VPS đã có ứng dụng khác dùng 8012/3012
# (nhớ sửa 2 upstream trong deploy/nginx.conf cho khớp).
API_PORT=8012
WEB_PORT=3012

# --- Cơ sở dữ liệu (đặt mật khẩu dài, ngẫu nhiên) ---
POSTGRES_PASSWORD=

# Tên miền được phép gửi form & thao tác admin (JSON)
LEADSCAN_ALLOWED_HOSTS=["leadscan.net"]

# Cookie đăng nhập admin chỉ gửi qua HTTPS. Chỉ đặt false khi chạy thử http://localhost
LEADSCAN_COOKIE_SECURE=true
LEADSCAN_SESSION_DAYS=7

# --- Gửi email: Resend (khuyên dùng) hoặc SMTP ---
# auto = dùng Resend nếu có API key, ngược lại SMTP · resend · smtp
LEADSCAN_MAIL_MAILER=resend
LEADSCAN_RESEND_API_KEY=
# Địa chỉ gửi đi — tên miền phải được xác minh trong Resend (Domains)
LEADSCAN_NOTIFY_FROM=no-reply@mcv.network
LEADSCAN_MAIL_FROM_NAME=MCV Network
# Email báo quản trị khi có đăng ký mới (để trống = không gửi)
LEADSCAN_NOTIFY_EMAIL=
LEADSCAN_ADMIN_URL=https://leadscan.net/admin
# SMTP (chỉ dùng khi không có Resend)
LEADSCAN_SMTP_HOST=
LEADSCAN_SMTP_PORT=587
LEADSCAN_SMTP_USER=
LEADSCAN_SMTP_PASSWORD=
LEADSCAN_SMTP_SSL=false

# --- Cổng thành viên ---
LEADSCAN_MEMBER_URL=https://leadscan.net/thanh-vien

# --- Thanh toán ---
# mcv = cổng thanh toán MCV (mặc định) · infocms = gọi thẳng InfoCMS (cần khoá RSA, chưa dùng)
# mock = giả lập tại chỗ để chạy thử (có nút "Giả lập đã thanh toán"; KHÔNG dùng trên production)
LEADSCAN_PAYMENT_PROVIDER=mcv

# Cổng MCV: 2 khoá do admin MCV cấp. Secret chỉ để trên server, không bao giờ đưa ra trình duyệt.
# Khoá test (mcvpk_test_…) không có QR thật; dùng nút giả lập. Production dùng mcvpk_live_….
MCV_API_KEY=
MCV_SECRET=
MCV_BASE_URL=https://api.mcv.network
# true CHỈ khi chạy thử bằng khoá test (nhận webhook test_mode, hiện nút giả lập). Production: false
LEADSCAN_MCV_ALLOW_TEST_MODE=false
# MCV đưa khách về đây sau khi trả (https + tên miền đã đăng ký với MCV). Webhook gửi MCV: https://<tên miền>/api/mcv/webhook
LEADSCAN_MCV_RETURN_URL=https://leadscan.net/thanh-vien/nap-tien/ket-qua
LEADSCAN_MCV_EXPIRES_MINUTES=15

# (Chỉ dùng khi LEADSCAN_PAYMENT_PROVIDER=infocms/mock) Tài khoản thu để tự sinh VietQR. BIN theo NAPAS, vd 970418 = BIDV
LEADSCAN_PAYMENT_BANK_BIN=
LEADSCAN_PAYMENT_BANK_NAME=
LEADSCAN_PAYMENT_ACCOUNT_NO=
LEADSCAN_PAYMENT_ACCOUNT_NAME=
# Webhook InfoCMS gọi về: https://<tên miền>/api/payments/infocms/webhook (ký HMAC-SHA256 trên body)
LEADSCAN_INFOCMS_WEBHOOK_SECRET=
LEADSCAN_INFOCMS_SIGNATURE_HEADER=X-Signature
LEADSCAN_ORDER_EXPIRE_HOURS=24

# Gói thành viên & nạp điểm (1 điểm = 1đ)
LEADSCAN_MEMBERSHIP_FEE=89000
LEADSCAN_MEMBERSHIP_POINTS=89000
LEADSCAN_MEMBERSHIP_DAYS=365
LEADSCAN_TOPUP_PACKS=[5000000,10000000,20000000,50000000]
LEADSCAN_TOPUP_MIN=1000000

# --- So khớp cơ hội (embedding Cohere + pgvector, chạy nền bằng Celery worker) ---
# Chỉ cần khoá API Cohere (https://dashboard.cohere.com/api-keys). Model & endpoint đã cài sẵn:
# Embed 5 Pro nhúng phiếu cơ hội, Embed 5 Fast nhúng phiếu tìm của khách, 1024 chiều, https://api.cohere.com/v2/embed.
# Để trống = dùng vector "hash" chạy tại chỗ (chỉ nên dùng khi chạy thử).
# Khoá Trial (miễn phí) dùng được các model trên nhưng: tối đa 1.000 lần gọi/tháng, 2.000 văn bản/phút và
# Cohere KHÔNG cho dùng khoá Trial cho mục đích thương mại/production. Hết lượt → so khớp chỉ dùng tiêu chí + từ khoá.
COHERE_API_KEY=
# Hạn mức lượt gọi Cohere mỗi tháng (khớp khoá Trial). Đổi sang khoá Production thì đặt 0 = không giới hạn.
LEADSCAN_COHERE_MONTHLY_LIMIT=1000

# --- Ảnh & tài liệu của phiếu cơ hội (Cloudflare R2, bucket RIÊNG TƯ) ---
# Admin gắn khi soạn phiếu; người mua xem/tải sau khi mua. Trình duyệt upload thẳng lên R2 bằng link ký sẵn.
# Để trống = tắt tính năng (form admin hiện "Chưa cấu hình lưu trữ"). Xem DEPLOY.md phần "Ảnh & tài liệu (Cloudflare R2)".
LEADSCAN_R2_ACCOUNT_ID=
LEADSCAN_R2_ACCESS_KEY_ID=
LEADSCAN_R2_SECRET_ACCESS_KEY=
LEADSCAN_R2_BUCKET=leadscan-files
# Tuỳ chọn: số tệp/phiếu (20), ảnh tối đa MB (10), tài liệu tối đa MB (25), hạn link xem/tải tính bằng giây (900)
# LEADSCAN_ATTACH_MAX_FILES=20
# LEADSCAN_ATTACH_IMAGE_MAX_MB=10
# LEADSCAN_ATTACH_FILE_MAX_MB=25
# LEADSCAN_ATTACH_URL_TTL=900
# Làm giàu dữ liệu MST: bản gốc trang/file nguồn lưu trên R2 ở trên (prefix enrich-raw/); chưa có R2 thì lưu ở volume
# enrichraw (docker-compose). User-Agent khi connector tự động gọi ra ngoài:
# LEADSCAN_ENRICH_USER_AGENT=LeadScanBot/1.0 (+https://leadscan.net)
# --- AI sinh văn bản: Cohere trước, có sự cố thì tự xuống DeepSeek ---
# Dùng cho: bóc tách tầng 3, trợ lý CRM, AI đọc thư Gmail, nút "AI viết lại" ở form Tìm cơ hội phù hợp.
# 1) Cohere Command A+ (command-a-plus-05-2026) — dùng chung COHERE_API_KEY ở mục so khớp phía trên. Khoá Trial: 1.000
#    lượt/tháng cho MỌI endpoint (tính chung với embedding) + chat 20 lượt/phút. Chat có trần riêng để chừa lượt cho embedding.
# 2) Cohere lỗi / quá tần suất (429) / hết lượt / khoá trial hết hạn → DeepSeek deepseek-flash (tắt suy nghĩ), cùng prompt.
# Lấy khoá DeepSeek tại platform.deepseek.com. Thiếu cả hai khoá → các nút AI báo "chưa cấu hình".
DEEPSEEK_API_KEY=
# LEADSCAN_COHERE_CHAT_MODEL=command-a-plus-05-2026
# LEADSCAN_COHERE_CHAT_MONTHLY_LIMIT=400   # trần lượt chat Cohere / tháng; hết → dùng DeepSeek tới tháng sau
# LEADSCAN_COHERE_PRICE_IN=0               # USD / 1 triệu token — Trial miễn phí; đặt giá khi lên khoá Production
# LEADSCAN_COHERE_PRICE_OUT=0
# LEADSCAN_DEEPSEEK_MODEL=deepseek-flash
# LEADSCAN_DEEPSEEK_PRICE_IN=0.30          # USD / 1 triệu token (giờ cao điểm; ngoài giờ bằng một nửa)
# LEADSCAN_DEEPSEEK_PRICE_OUT=1.20
# LEADSCAN_SEARCH_AI_REWRITE_PER_HOUR=20   # số lượt "AI viết lại" mỗi doanh nghiệp / giờ
# Tầng 3 bóc tách cho báo cáo quản trị mà bảng/luật không đọc được. TẮT mặc định — chỉ bật khi
# pháp chế đồng ý gửi văn bản (đã cắt danh sách người nội bộ) ra API nước ngoài. Kết quả luôn qua duyệt.
# LEADSCAN_ENRICH_LLM_ENABLED=false
# CRM Lite hạng Vàng — nút AI "Tóm tắt công ty" / "Soạn tin mời". TẮT mặc định:
# chỉ gửi dữ liệu doanh nghiệp, không gửi tên/SĐT/email người liên hệ. Trần chi phí mỗi doanh nghiệp / tháng tính theo giá API.
# LEADSCAN_CRM_AI_ENABLED=false
# LEADSCAN_CRM_AI_BUDGET_USD=22
# Thu thập cơ hội từ Gmail (hướng dẫn cài: deploy/gmail-appscript/README.md). Khoá chung với Apps Script — tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"      Để trống = tắt webhook.
# LEADSCAN_GMAIL_WEBHOOK_SECRET=
# AI đọc thư → JSON cơ hội (AI sinh văn bản ở trên). TẮT mặc định: chỉ bật khi pháp chế đồng ý gửi nội dung thư
# khách ra API AI nước ngoài. Tắt thì thư qua lọc sơ bộ vào "Cần xem lại" để admin tự tạo phiếu.
# LEADSCAN_GMAIL_AI_ENABLED=false
# LEADSCAN_GMAIL_AI_BUDGET_USD=10
# Lĩnh vực nhận cơ hội (JSON, tên ngành như form đăng ký). Cơ hội ngành khác → "Không phải cơ hội".
# LEADSCAN_GMAIL_INDUSTRIES=["Bao bì & in ấn"]
# LEADSCAN_GMAIL_MIN_CONFIDENCE=0.6   # AI chắc chắn dưới mức này → "Cần xem lại"
# LEADSCAN_GMAIL_BODY_KEEP_DAYS=7     # thư bị loại / bỏ qua: xoá nội dung sau số ngày này
# Email nhắc việc 8:00 hằng ngày + báo cáo tuần thứ Hai (cần celery beat đang chạy)
# LEADSCAN_CRM_REMINDERS_ENABLED=true
# Chạy thử CRM với vài khách hạng Vàng: mã khách (LS-...) cách nhau dấu phẩy. Để trống = mở cho mọi khách hạng Vàng.
# LEADSCAN_CRM_PILOT_CODES=LS-20261101-ABC123,LS-20261105-DEF456
# Mã hoá kho B (MST cá nhân, bản gốc trang nguồn) — BẮT BUỘC đặt trên máy chủ thật, TRƯỚC khi có dữ liệu:
#   docker compose exec api python -m app.cli gen-data-key
# Cất bản sao khoá ở nơi khác VPS: mất khoá = mất MST cá nhân và bản gốc đã mã hoá.
LEADSCAN_ENRICH_DATA_KEY=
# Thời hạn: bản gốc (ngày), dữ liệu cá nhân không dùng (tháng) → rà soát xoá, hạn file xuất (ngày)
# LEADSCAN_ENRICH_RAW_RETENTION_DAYS=365
# LEADSCAN_ENRICH_RETENTION_MONTHS=24
# LEADSCAN_ENRICH_EXPORT_VALID_DAYS=90
# Sao lưu mã hoá hằng ngày (deploy/backup.sh): passphrase dài, cất ở nơi khác VPS
BACKUP_PASSPHRASE=
# BACKUP_DIR=/var/backups/leadscan
# BACKUP_KEEP_DAYS=30

# Yêu cầu xuất hoá đơn gửi tới email kế toán (xuất thủ công). Cần cấu hình Resend/SMTP ở trên để gửi được.
LEADSCAN_INVOICE_EMAIL=vylyy9999@gmail.com

# --- Hoá đơn điện tử IAM Invoice: tự xuất HĐĐT sau khi thanh toán ---
# Bật thì khách thanh toán xong hệ thống tự xuất hoá đơn theo tên/MST/địa chỉ doanh nghiệp đã đăng ký
# (thiếu địa chỉ → chờ khách gửi form). IAM lỗi → thử lại, vẫn lỗi thì email LEADSCAN_INVOICE_EMAIL để xuất thủ công.
# Tắt (false) → xuất thủ công: thanh toán xong email đủ thông tin hoá đơn (người mua, hàng hoá, tiền thuế) tới
# LEADSCAN_INVOICE_EMAIL, không gọi IAM. Thuế suất / đơn vị tính bên dưới dùng cho cả 2 cách.
LEADSCAN_IAM_ENABLED=false
# Chạy thật; demo: https://demo-invoice.iamsoftware.com.vn (tài khoản 0312303803-999, ký hiệu 1 / C26TYY)
LEADSCAN_IAM_BASE_URL=https://invoice.iamsoftware.com.vn
LEADSCAN_IAM_USERNAME=0111272400
LEADSCAN_IAM_PASSWORD=
# Mẫu số + ký hiệu đã đăng ký trên IAM (tài khoản demo 0312303803-999 dùng 1 / C26TYY)
LEADSCAN_IAM_INVOICE_FORM=1
LEADSCAN_IAM_INVOICE_SERIAL=
# Ký số luôn (true) hay chỉ tạo nháp để kế toán vào IAM ký (false)
LEADSCAN_IAM_SIGN=true
# Mã PIN chứng thư số IntrustCA ký từ xa; serial chứng thư để trống = tự lấy chứng thư đầu tiên của tài khoản
LEADSCAN_IAM_PIN_CODE=
LEADSCAN_IAM_CERT_SN=
# Thuế suất GTGT (0, 5, 8, 10, KCT, KKKNT) — số tiền đơn hàng đã gồm thuế
LEADSCAN_IAM_VAT_RATE=10
# false = không tự xuất / email khi thanh toán, chỉ khi khách gửi form "Thông tin xuất hoá đơn"
LEADSCAN_IAM_ISSUE_ON_PAYMENT=true

# --- Sự kiện (/su-kien) ---
# Đăng ký tham dự (họ tên, SĐT, email, nhu cầu xúc tiến, profile PDF) gửi về email này; từng sự kiện có thể
# đặt email riêng trong trang quản trị. Để trống = gửi về LEADSCAN_NOTIFY_EMAIL.
LEADSCAN_EVENT_EMAIL=
# LEADSCAN_EVENT_RATE_LIMIT_PER_HOUR=10   # số lượt đăng ký tối đa mỗi IP / giờ
# LEADSCAN_EVENT_PROFILE_MAX_MB=10        # profile doanh nghiệp (PDF) đính kèm
# LEADSCAN_EVENT_PROOF_MAX_MB=8           # ảnh chụp màn hình chuyển khoản
# Profile PDF và ảnh chuyển khoản lưu trên Cloudflare R2 ở trên (thư mục SUKIEN/). Chưa cấu hình R2 = form
# đăng ký vẫn chạy nhưng không nhận được tệp.
# Tài khoản nhận phí tham dự: điền riêng cho từng sự kiện trong trang quản trị; để trống thì dùng tài khoản thu
# chung LEADSCAN_PAYMENT_BANK_BIN / ACCOUNT_NO ở mục Thanh toán phía trên để sinh mã VietQR.

# Đối soát ảnh chuyển khoản bằng OCR.space (https://ocr.space/ocrapi — đăng ký lấy khoá miễn phí).
# Có khoá: hệ thống đọc chữ trong ảnh, khớp đủ mã đăng ký + số tiền → tự chuyển "Đã thanh toán".
# Để trống: mọi ảnh vào "Chờ đối soát" để ban tổ chức tự xác nhận trong trang quản trị.
OCR_SPACE_API_KEY=
# LEADSCAN_OCR_SPACE_ENGINE=2        # 2 = máy nhận dạng mới (tốt với ảnh chụp app ngân hàng); 1 cần đặt ngôn ngữ
# LEADSCAN_OCR_SPACE_LANGUAGE=eng
# LEADSCAN_OCR_AMOUNT_TOLERANCE=0    # sai lệch cho phép khi so số tiền (đồng)
# LEADSCAN_OCR_REQUIRE_AMOUNT=true   # false = chỉ cần đúng mã đăng ký là tự xác nhận

# --- Tuyển dụng (/tuyen-dung) ---
# Hồ sơ ứng viên (kèm file CV) gửi về email này; từng bài có thể đặt email riêng trong trang quản trị.
# Để trống = gửi về LEADSCAN_NOTIFY_EMAIL. Cần cấu hình Resend/SMTP ở trên để gửi được.
LEADSCAN_RECRUIT_EMAIL=
# Link bài tuyển dụng trong email
LEADSCAN_SITE_URL=https://leadscan.net
# LEADSCAN_APPLY_RATE_LIMIT_PER_HOUR=5
# LEADSCAN_APPLY_CV_MAX_MB=5

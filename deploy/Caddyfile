# Caddy: tự xin & gia hạn chứng chỉ HTTPS (Let's Encrypt) cho SITE_ADDRESS.
#   SITE_ADDRESS=leadscan.mcv.network            → HTTPS thật trên VPS (DNS phải trỏ về VPS, mở cổng 80/443)
#   SITE_ADDRESS=:80                             → chạy thử HTTP trên máy local
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API → FastAPI. X-Real-IP luôn bị ghi đè bằng IP thật nên khách không giả mạo được (dùng cho rate limit).
	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Còn lại → Next.js (landing, sau này portal & admin)
	handle {
		reverse_proxy web:3000
	}
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "python",
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "API_INTERNAL_URL": "http://localhost:8010"
      }
    },
    {
      "name": "legacy-html",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web"
      ],
      "port": 8090
    }
  ]
}
